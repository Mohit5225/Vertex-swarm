# PostgreSQL (Neon) Configuration
# Get your DATABASE_URL from Neon dashboard (https://console.neon.tech/)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require&channel_binding=require

# Redis Configuration (local or cloud)
REDIS_URL=redis://localhost:6379/0

# Neon Auth (Phase 2) — JWT Verification
# Get these endpoints from your Neon Auth configuration (Neon Console > Auth > Endpoints)
NEON_AUTH_BASE_URL=https://<your-project>.neonauth.<region>.aws.neon.tech/<db>/auth
NEON_AUTH_JWKS_URL=https://<your-project>.neonauth.<region>.aws.neon.tech/<db>/auth/.well-known/jwks.json
JWT_ALGORITHM=EdDSA
JWT_CACHE_TTL_SECONDS=3600
JWT_TOKEN_LEEWAY_SECONDS=300

# Environment
ENV=development
DEBUG=True

# OpenRouter Configuration (Phase 3)
# Removed four duplicated OpenRouter comment lines; kept one section header.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openrouter/ximi/ximi-mimo-v2-flash
OPENROUTER_FALLBACK_MODEL=openrouter/z-ai/glm-4.5-air:free
OPENROUTER_REASONING_EFFORT=low
