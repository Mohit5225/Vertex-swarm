\\n        if (!res.ok) {\\\\n          throw new Error(`Failed to load count: ${res.status}`);\\\\n        }\\\\n        const data = await res.json();\\\\n        setCount(data.value ?? 0);\\\\n      } catch (err) {\\\\n        console.error(\\\\\\\"Failed to fetch count\\\\\\\", err);\\\\n        setError(\\\\n          \\\\\\\"Couldn't load the current count. Check the backend at http://localhost:9000.\\\\\\\"\\\\n        );\\\\n      }\\\\n    };\\\\n\\\\n    loadCount();\\\\n  }, [apiBase]);\\\\n\\\\n  const increment = async () => {\\\\n    try {\\\\n      setError(\\\\\\\"\\\\\\\");\\\\n      const res = await fetch(`${apiBase}/api/increment`, {\\\\n        method: \\\\\\\"POST\\\\\\\",\\\\n      });\\\\n      if (!res.ok) {\\\\n        throw new Error(`Failed to increment: ${res.status}`);\\\\n      }\\\\n      const data = await res.json();\\\\n      setCount(data.value);\\\\n    } catch (e) {\\\\n      console.error(\\\\\\\"Failed to increment\\\\\\\", e);\\\\n      setError(\\\\\\\"Couldn't increment the counter.\\\\\\\");\\\\n    }\\\\n  };\\\\n\\\\n  return (\\\\n    <section className=\\\\\\\"rounded-3xl border border-white/10 bg-white/10 p-6 shadow-2xl shadow-black/20 backdrop-blur-xl sm:p-8\\\\\\\">\\\\n      <div className=\\\\\\\"flex flex-col gap-6 md:flex-row md:items-end md:justify-between\\\\\\\">\\\\n        <div className=\\\\\\\"space-y-2\\\\\\\">\\\\n          <p className=\\\\\\\"text-sm uppercase tracking-[0.3em] text-cyan-200/80\\\\\\\">\\\\n            Counter status\\\\n          </p>\\\\n          <h2 className=\\\\\\\"text-3xl font-bold text-white\\\\\\\">Live backend check</h2>\\\\n          <p className=\\\\\\\"max-w-xl text-sm leading-6 text-slate-300\\\\\\\">\\\\n            The current value is fetched from{\\\\\\\" \\\\\\\"}\\\\n            <code className=\\\\\\\"rounded bg-black/30 px-1.5 py-0.5 text-cyan-100\\\\\\\">\\\\n              {`${apiBase}/api/value`}\\\\n            </code>\\\\n            .\\\\n          </p>\\\\n        </div>\\\\n\\\\n        <div className=\\\\\\\"flex items-center gap-4\\\\\\\">\\\\n          <div className=\\\\\\\"rounded-2xl border border-white/10 bg-slate-950/50 px-5 py-4 text-center\\\\\\\">\\\\n            <p className=\\\\\\\"text-xs uppercase tracking-[0.28em] text-slate-400\\\\\\\">\\\\n              Count\\\\n            </p>\\\\n            <p className=\\\\\\\"mt-1 text-5xl font-black text-cyan-300\\\\\\\">{count}</p>\\\\n          </div>\\\\n          <button\\\\n            onClick={increment}\\\\n            className=\\\\\\\"inline-flex h-14 items-center justify-center rounded-2xl bg-cyan-400 px-5 font-semibold text-slate-950 transition hover:-translate-y-0.5 hover:bg-cyan-300 active:translate-y-0\\\\\\\"\\\\n          >\\\\n            Increment\\\\n          </button>\\\\n        </div>\\\\n      </div>\\\\n\\\\n      <div className=\\\\\\\"mt-6 flex flex-wrap gap-3 text-xs text-slate-300\\\\\\\">\\\\n        <span className=\\\\\\\"rounded-full border border-white/10 bg-white/5 px-3 py-1\\\\\\\">\\\\n          Tailwind classes active\\\\n        </span>\\\\n        <span className=\\\\\\\"rounded-full border border-white/10 bg-white/5 px-3 py-1\\\\\\\">\\\\n          API base: {apiBase}\\\\n        </span>\\\\n      </div>\\\\n\\\\n      {error ? (\\\\n        <p className=\\\\\\\"mt-5 rounded-2xl border border-rose-400/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200\\\\\\\">\\\\n          {error}\\\\n        </p>\\\\n      ) : null}\\\\n    </section>\\\\n  );\\\\n}\\\\n\\\",\\\"current_hash\\\":\\\"fnv1a-1a5ee8a1-3286\\\",\\\"total_lines\\\":99,\\\"status\\\":\\\"success\\\"}],\\\"truncated\\\":false}\", \"data\": {\"files\": [{\"path\": \"c:\\\\Users\\\\mohit\\\\Desktop\\\\python\\\\TESTING_VERTEX_SWARM\\\\backend\\\\main.py\", \"content\": \"from fastapi import FastAPI\\nfrom fastapi.middleware.cors import CORSMiddleware\\nfrom pydantic import BaseModel\\nimport uvicorn\\n\\napp = FastAPI()\\n\\napp.add_middleware(\\n    CORSMiddl