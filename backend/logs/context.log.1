ue: int = 0\\n\\ncounter = Counter()\\n\\n@app.post(\\\"/api/increment\\\")\\nasync def increment_counter():\\n    counter.value += 1\\n    return {\\\"value\\\": counter.value}\\n\\nif __name__ == \\\"__main__\\\":\\n    import sys\\n    port = int(sys.argv[1]) if len(sys.argv) > 1 else 8000\\n    uvicorn.run(app, host=\\\"0.0.0.0\\\", port=port)\\n\\n\\n\\n@app.get(\\\"/api/value\\\")\\nasync def get_value():\\n    return {\\\"value\\\": counter.value}\\n\", \"current_hash\": \"fnv1a-de0b4d4d-591\", \"total_lines\": 31, \"status\": \"success\"}, {\"path\": \"c:\\\\Users\\\\mohit\\\\Desktop\\\\python\\\\TESTING_VERTEX_SWARM\\\\frontend\\\\app\\\\components\\\\Counter.jsx\", \"content\": \"\\\"use client\\\";\\n\\nimport { useState, useEffect } from 'react';\\n\\nexport default function Counter() {\\n  const [count, setCount] = useState(0);\\n  const [error, setError] = useState(\\\"\\\");\\n  const apiBase = process.env.NEXT_PUBLIC_API_BASE_URL || \\\"http://localhost:7999\\\";\\n\\n  useEffect(() => {\\n    const loadCount = async () => {\\n      try {\\n        setError(\\\"\\\");\\n        const res = await fetch(`${apiBase}/api/value`);\\n        if (!res.ok) {\\n          throw new Error(`Failed to load count: ${res.status}`);\\n        }\\n        const data = await res.json();\\n        setCount(data.value ?? 0);\\n      } catch (err) {\\n        console.error('Failed to fetch count', err);\\n        setError(\\\"Couldn't load the current count.\\\");\\n      }\\n    };\\n\\n    loadCount();\\n  }, [apiBase]);\\n\\n  const increment = async () => {\\n    try {\\n      setError(\\\"\\\");\\n      const res = await fetch(`${apiBase}/api/increment`, {\\n        method: 'POST',\\n      });\\n      if (!res.ok) {\\n        throw new Error(`Failed to increment: ${res.status}`);\\n      }\\n      const data = await res.json();\\n      setCount(data.value);\\n    } catch (e) {\\n      console.error('Failed to increment', e);\\n      setError(\\\"Couldn't increment t