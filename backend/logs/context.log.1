st apiBase =\\n    process.env.NEXT_PUBLIC_API_BASE_URL || \\\"http://localhost:9000\\\";\\n\\n  useEffect(() => {\\n    const loadCount = async () => {\\n      try {\\n        setError(\\\"\\\");\\n        const res = await fetch(`${apiBase}/api/value`);\\n        if (!res.ok) {\\n          throw new Error(`Failed to load count: ${res.status}`);\\n        }\\n        const data = await res.json();\\n        setCount(data.value ?? 0);\\n      } catch (err) {\\n        console.error(\\\"Failed to fetch count\\\", err);\\n        setError(\\n          \\\"Couldn't load the current count. Check the backend at http://localhost:9000.\\\"\\n        );\\n      }\\n    };\\n\\n    loadCount();\\n  }, [apiBase]);\\n\\n  const increment = async () => {\\n    try {\\n      setError(\\\"\\\");\\n      const res = await fetch(`${apiBase}/api/increment`, {\\n        method: \\\"POST\\\",\\n      });\\n      if (!res.ok) {\\n        throw new Error(`Failed to increment: ${res.status}`);\\n      }\\n      const data = await res.json();\\n      setCount(data.value);\\n    } catch (e) {\\n      console.error(\\\"Failed to increment\\\", e);\\n      setError(\\\"Couldn't increment the counter.\\\");\\n    }\\n  };\\n\\n      const data = await res.json();\\n      setCount(data.value);\\n    } catch (e) {\\n      console.error(\\\"Failed to increment\\\", e);\\n      setError(\\\"Couldn't increment the counter.\\\");\\n    }\\n  };\\n\\n  const decrement = async () => {\\n    try {\\n      setError(\\\"\\\");\\n      const res = await fetch(`${apiBase}/api/decrement`, {\\n        method: \\\"POST\\\",\\n      });\\n      if (!res.ok) {\\n        throw new Error(`Failed to decrement: ${res.status}`);\\n      }\\n      const data = await res.json();\\n      setCount(data.value);\\n    } catch (e) {\\n      console.error(\\\"Failed to decrement\\\", e);\\n      setError(\\\"Couldn't decrement the counter.\\\");\\n    }\\n  };\\n\\n  const reset = async () => {\\n    try {\\n      setError