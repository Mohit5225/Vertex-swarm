${apiBase}/api/increment`, {\\n        method: \\\"POST\\\",\\n      });\\n      if (!res.ok) {\\n        throw new Error(`Failed to increment: ${res.status}`);\\n      }\\n      const data = await res.json();\\n      setCount(data.value);\\n    } catch (e) {\\n      console.error(\\\"Failed to increment\\\", e);\\n      setError(\\\"Couldn't increment the counter.\\\");\\n    }\\n  };\\n\\n      const data = await res.json();\\n      setCount(data.value);\\n;\\n\\n  const decrement = async () => {\\n    try {\\n      setError(\\\"\\\");\\n      const res = await fetch(`${apiBase}/api/decrement`, {\\n        method: \\\"POST\\\",\\n      });\\n      if (!res.ok) {\\n        throw new Error(`Failed to decrement: ${res.status}`);\\n      }\\n      const data = await res.json();\\n      setCount(data.value);\\n    } catch (e) {\\n      console.error(\\\"Failed to decrement\\\", e);\\n      setError(\\\"Couldn't decrement the counter.\\\");\\n    }\\n  };\\n\\n  const reset = async () => {\\n    try {\\n      setError(\\\"\\\");\\n      const res = await fetch(`${apiBase}/api/reset`, {\\n        method: \\\"POST\\\",\\n      });\\n      if (!res.ok) {\\n        throw new Error(`Failed to reset: ${res.status}`);\\n      }\\n      const data = await res.json();\\n      setCount(data.value);\\n    } catch (e) {\\n      console.error(\\\"Failed to reset\\\", e);\\n      setError(\\\"Couldn't reset the counter.\\\");\\n    }\\n  };\\n\\n  return (\\n    <section className=\\\"rounded-3xl border border-white/10 bg-white/10 p-6 shadow-2xl shadow-black/20 backdrop-blur-xl sm:p-8\\\">\\n      <div className=\\\"flex flex-col gap-6 md:flex-row md:items-end md:justify-between\\\">\\n        <div className=\\\"space-y-2\\\">\\n          <p className=\\\"text-sm uppercase tracking-[0.3em] text-cyan-200/80\\\">\\n            Counter status\\n          </p>\\n          <h2 className=\\\"text-3xl font-bold text-white\\\">Live backend check</h2>\\n          <p className=\\\"max-w-xl tex