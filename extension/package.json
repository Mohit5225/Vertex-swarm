{
  "name": "vertex-swarm-extension",
  "displayName": "Vertex Swarm",
  "publisher": "mohit-murjani",
  "license": "SEE LICENSE IN LICENSE.txt",
  "description": "LLM-powered agent execution in VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vertex-swarm",
          "title": "Vertex Swarm",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "vertex-swarm": [
        {
          "type": "webview",
          "id": "vertex-swarm.sidebar",
          "name": "Chat"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "vertex-swarm.participant",
        "name": "vertex-swarm",
        "fullName": "Vertex Swarm",
        "description": "Run Vertex Swarm from Chat",
        "isSticky": true
      }
    ],
    "commands": [
      {
        "command": "vertex-swarm.start",
        "title": "Vertex: Start Agent"
      },
      {
        "command": "vertex-swarm.logout",
        "title": "Sign Out",
        "icon": "$(sign-out)"
      },
      {
        "command": "vertex-swarm.toggleHistory",
        "title": "Recent Chats",
        "icon": "$(history)"
      },
      {
        "command": "vertex-swarm.toggleSession",
        "title": "Session",
        "icon": "$(settings-gear)"
      },
      {
        "command": "vertex-swarm.requestLogout",
        "title": "Sign Out",
        "icon": "$(sign-out)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vertex-swarm.toggleHistory",
          "when": "view == vertex-swarm.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "vertex-swarm.toggleSession",
          "when": "view == vertex-swarm.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "vertex-swarm.requestLogout",
          "when": "view == vertex-swarm.sidebar",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Vertex Swarm",
      "properties": {
        "vertexSwarm.snapshotRetentionDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 7,
          "description": "How many days to keep undo snapshots before garbage collection deletes them."
        },
        "vertexSwarm.llmBaseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com/v1",
          "description": "Base URL for the LLM API"
        },
        "vertexSwarm.llmModel": {
          "type": "string",
          "default": "deepseek-v4-pro",
          "description": "Model identifier to use for inference"
        },
        "vertexSwarm.llmReasoningEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable DeepSeek thinking mode (reasoning_content) for better tool-use accuracy"
        },
        "vertexSwarm.llmReasoningEffort": {
          "type": "string",
          "default": "medium",
          "enum": ["low", "medium", "high", "max", "xhigh"],
          "description": "Reasoning depth for DeepSeek thinking mode."
        }
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "vite build",
    "test:extension": "node --test test/workspace-ops-contract.test.mjs",
    "package": "vsce package"
  },
  "dependencies": {
    "@types/diff": "^7.0.2",
    "@vscode/ripgrep": "^1.17.1",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "~5.3.3",
    "vite": "^8.0.8"
  }
}
