# PostgreSQL (Neon) Configuration
# Get your DATABASE_URL from Neon dashboard (https://console.neon.tech/)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require&channel_binding=require

# Redis Configuration (local or cloud)
REDIS_URL=redis://localhost:6379/0

# Neon Auth (Phase 2) — JWT Verification
# Get these endpoints from your Neon Auth configuration (Neon Console > Auth > Endpoints)
NEON_AUTH_BASE_URL=https://<your-project>.neonauth.<region>.aws.neon.tech/<db>/auth
NEON_AUTH_JWKS_URL=https://<your-project>.neonauth.<region>.aws.neon.tech/<db>/auth/.well-known/jwks.json
JWT_ALGORITHM=EdDSA
JWT_CACHE_TTL_SECONDS=3600
JWT_TOKEN_LEEWAY_SECONDS=300

# Vertex extension auth broker (Phase 3)
# APP_AUTH_SECRET must be at least 32 bytes for HS256.
APP_AUTH_SECRET=replace-with-a-strong-32-byte-or-longer-random-secret
APP_AUTH_ALGORITHM=HS256
APP_AUTH_ISSUER=vertex-swarm-backend
APP_AUTH_AUDIENCE=vertex-swarm-extension
# Legacy shared TTL (used if explicit access/refresh TTL are not set)
APP_AUTH_TOKEN_TTL_SECONDS=604800
# Preferred explicit TTLs
APP_AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
APP_AUTH_REFRESH_TOKEN_TTL_SECONDS=604800

# Environment
ENV=development
DEBUG=True

# OpenAI-compatible LLM provider (OpenRouter active; Modal kept for rollback)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=baidu/cobuddy:free
OPENROUTER_FALLBACK_MODEL=baidu/cobuddy:free
OPENROUTER_REASONING_ENABLED=False
OPENROUTER_REASONING_EFFORT=low

# Legacy Modal configuration retained for rollback.
# MODAL_BASE_URL=https://api.us-west-2.modal.direct/v1
# MODAL_API_KEY=your-modal-api-key
# MODAL_MODEL=zai-org/GLM-5-FP8
