# PostgreSQL (Neon) Configuration
# Get your DATABASE_URL from Neon dashboard (https://console.neon.tech/)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require&channel_binding=require

# Redis Configuration (local or cloud)
REDIS_URL=redis://localhost:6379/0

# Neon Auth (Phase 2) — JWT Verification
# Get these endpoints from your Neon Auth configuration
NEON_AUTH_BASE_URL=https://your-neon-instance.neonauth.c-4.us-east-1.aws.neon.tech/auth
NEON_AUTH_JWKS_URL=https://your-neon-instance.neonauth.c-4.us-east-1.aws.neon.tech/auth/.well-known/jwks.json
JWT_ALGORITHM=EdDSA
JWT_CACHE_TTL_SECONDS=3600

# Environment
ENV=development
DEBUG=True
