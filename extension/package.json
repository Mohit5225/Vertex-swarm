{
  "name": "vertex-swarm-extension",
  "displayName": "Vertex Swarm",
  "description": "LLM-powered agent execution in VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:vertex-swarm.sidebar"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vertex-swarm",
          "title": "Vertex Swarm",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "vertex-swarm": [
        {
          "type": "webview",
          "id": "vertex-swarm.sidebar",
          "name": "Chat"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "vertex-swarm.participant",
        "name": "vertex-swarm",
        "fullName": "Vertex Swarm",
        "description": "Run Vertex Swarm from Chat",
        "isSticky": true
      }
    ],
    "commands": [
      {
        "command": "vertex-swarm.start",
        "title": "Vertex: Start Agent"
      },
      {
        "command": "vertex-swarm.logout",
        "title": "Sign Out",
        "icon": "$(sign-out)"
      }
    ]
  },
  "scripts": {
    "dev": "vite build --watch",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "vite build",
    "test:extension": "node --test test/workspace-ops-contract.test.mjs",
    "package": "vsce package"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "~5.3.3",
    "vite": "^8.0.8"
  }
}
